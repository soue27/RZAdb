DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/rzadb

SESSION_SECRET=your_session_secret_here
LOG_LEVEL=INFO
DOCUMENT_TEMPLATES_DIR=data/document_templates

# PostgreSQL backup (run with: uv run python -m app.infrastructure.backup)
BACKUP_ENABLED=false
BACKUP_LOCAL_ENABLED=true
BACKUP_LOCAL_DIR=data/backups
BACKUP_LOCAL_RETENTION_COUNT=7
BACKUP_EMAIL_ENABLED=false
BACKUP_EMAIL_TO=
BACKUP_YANDEX_DISK_ENABLED=false
BACKUP_YANDEX_DISK_TOKEN=
BACKUP_YANDEX_DISK_FOLDER=/RZAdb/backups
BACKUP_YANDEX_DISK_RETENTION_COUNT=7

# SMTP — email digest
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
SMTP_USE_SSL=false


FEEDBACK_EMAIL=адрес_суперадмина@example.com
APP_BASE_URL=https://адрес-твоего-приложения
FEEDBACK_MAX_LENGTH=5000
