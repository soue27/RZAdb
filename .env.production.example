# Copy to .env.production on the VPS and replace every placeholder.
RZADB_DATA_ROOT=/srv/rzadb
RZADB_UID=10001
RZADB_GID=10001

POSTGRES_DB=rzadb
POSTGRES_USER=rzadb
POSTGRES_PASSWORD=replace_with_url_safe_random_secret

# Keep credentials consistent with POSTGRES_DB/USER/PASSWORD above.
# Use a URL-safe password (for example, openssl rand -hex 32).
DATABASE_URL=postgresql+asyncpg://rzadb:replace_with_url_safe_random_secret@db:5432/rzadb
SESSION_SECRET=replace_with_a_separate_random_secret
SESSION_COOKIE_SECURE=true
DEBUG=false
LOG_LEVEL=INFO
WEB_CONCURRENCY=1
DOCUMENT_TEMPLATES_DIR=data/document_templates

# PostgreSQL backups (local volume is persistent; schedule via host systemd).
BACKUP_ENABLED=true
BACKUP_LOCAL_ENABLED=true
BACKUP_LOCAL_DIR=data/backups
BACKUP_LOCAL_RETENTION_COUNT=7
BACKUP_EMAIL_ENABLED=false
BACKUP_EMAIL_TO=
BACKUP_YANDEX_DISK_ENABLED=false
BACKUP_YANDEX_DISK_TOKEN=
BACKUP_YANDEX_DISK_FOLDER=/RZAdb/backups
BACKUP_YANDEX_DISK_RETENTION_COUNT=7

# SMTP is required for Email Digest and optional backup/error email channels.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
ERROR_EMAIL_TO=
FEEDBACK_EMAIL=
APP_BASE_URL=
FEEDBACK_MAX_LENGTH=5000
