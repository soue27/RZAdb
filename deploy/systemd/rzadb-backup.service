[Unit]
Description=Create and verify the RZAdb PostgreSQL backup
Requires=docker.service
After=docker.service
OnFailure=rzadb-monitor.service

[Service]
Type=oneshot
WorkingDirectory=/opt/rzadb
Environment=TZ=Asia/Yekaterinburg
UMask=0077
ExecStart=/usr/bin/docker compose --env-file /opt/rzadb/.env.production -f /opt/rzadb/compose.production.yaml exec -T web python -m app.infrastructure.backup
StandardOutput=journal
StandardError=journal
TimeoutStartSec=infinity
